{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-journey.local/schemas/investigation-frontmatter.schema.json",
  "title": "Investigation Frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "status",
    "created_at",
    "updated_at",
    "ended_at",
    "abandon_reason",
    "origin",
    "domains",
    "related_nodes",
    "labs",
    "outcome",
    "promotion_target"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^investigation\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": { "const": "investigation" },
    "status": {
      "description": "closed and abandoned are terminal, and cross-file validation requires all linked Labs to be terminal first.",
      "enum": ["active", "closed", "abandoned"]
    },
    "created_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" },
    "ended_at": { "$ref": "#/$defs/nullable_date" },
    "abandon_reason": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reference"],
          "properties": {
            "type": { "const": "inbox" },
            "reference": {
              "type": "string",
              "pattern": "^inbox/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reference"],
          "properties": {
            "type": { "const": "knowledge_note" },
            "reference": { "$ref": "#/$defs/node_id" }
          }
        }
      ]
    },
    "domains": {
      "description": "Complete inventory of materially involved Domains, including at least those implied by a Knowledge Note origin, related_nodes, promotion_target, and linked Labs' related_nodes.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domain_id" }
    },
    "related_nodes": {
      "description": "Contextual Knowledge Nodes other than promotion_target. These references do not require Knowledge Note backlinks.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/node_id" }
    },
    "labs": {
      "description": "Labs owned by this Investigation. Every listed Lab must point back through its singular investigation field.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^labs/[a-z0-9]+(?:-[a-z0-9]+)*/README\\.md$"
      }
    },
    "outcome": {
      "enum": [
        "pending",
        "update_existing_node",
        "create_new_node",
        "no_promotion"
      ]
    },
    "promotion_target": {
      "description": "The one Knowledge Node actually changed by promotion. It may equal a knowledge_note origin reference, but must not be duplicated in related_nodes.",
      "oneOf": [
        { "$ref": "#/$defs/node_id" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "active" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "ended_at": { "type": "null" },
          "abandon_reason": { "type": "null" },
          "outcome": { "const": "pending" },
          "promotion_target": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "closed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "ended_at": { "$ref": "#/$defs/date" },
          "outcome": { "not": { "const": "pending" } },
          "abandon_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "abandoned" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "ended_at": { "$ref": "#/$defs/date" },
          "outcome": { "const": "no_promotion" },
          "abandon_reason": { "type": "string", "minLength": 1 },
          "promotion_target": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": { "enum": ["pending", "no_promotion"] }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": { "promotion_target": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": ["update_existing_node", "create_new_node"]
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "promotion_target": { "$ref": "#/$defs/node_id" }
        }
      }
    }
  ],
  "$defs": {
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": { "type": "string", "format": "date" },
    "nullable_date": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "type": "null" }
      ]
    }
  }
}
