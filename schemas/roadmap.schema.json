{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-journey.local/schemas/roadmap.schema.json",
  "title": "Learning Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "domain",
    "title",
    "goal",
    "starting_point",
    "status",
    "ended_at",
    "archive_reason",
    "phases",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "domain": { "$ref": "#/$defs/domain_id" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "starting_point": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "completed", "archived"] },
    "ended_at": { "$ref": "#/$defs/nullable_date" },
    "archive_reason": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Array order is the formal phase order.",
      "items": { "$ref": "#/$defs/phase" }
    },
    "created_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "active" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "ended_at": { "type": "null" },
          "archive_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "ended_at": { "$ref": "#/$defs/date" },
          "archive_reason": { "type": "null" },
          "phases": {
            "contains": {
              "type": "object",
              "properties": {
                "items": {
                  "contains": {
                    "type": "object",
                    "properties": { "status": { "const": "completed" } },
                    "required": ["status"]
                  }
                }
              },
              "required": ["items"]
            },
            "items": {
              "type": "object",
              "properties": {
                "items": {
                  "not": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "status": { "enum": ["planned", "in_progress"] }
                      },
                      "required": ["status"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "archived" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "ended_at": { "$ref": "#/$defs/date" },
          "archive_reason": { "type": "string", "minLength": 1 },
          "phases": {
            "items": {
              "type": "object",
              "properties": {
                "items": {
                  "not": {
                    "contains": {
                      "type": "object",
                      "properties": { "status": { "const": "in_progress" } },
                      "required": ["status"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/domain_id" },
        "title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Array order is the formal learning order within the phase.",
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "status", "completed_at"],
      "properties": {
        "node": { "$ref": "#/$defs/node_id" },
        "status": {
          "enum": ["planned", "in_progress", "completed", "skipped"]
        },
        "completed_at": { "$ref": "#/$defs/nullable_date" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "completed_at": { "$ref": "#/$defs/date" } }
          },
          "else": {
            "properties": { "completed_at": { "type": "null" } }
          }
        }
      ]
    },
    "nullable_date": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "type": "null" }
      ]
    }
  }
}
