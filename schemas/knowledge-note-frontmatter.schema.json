{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-journey.local/schemas/knowledge-note-frontmatter.schema.json",
  "title": "Knowledge Note Frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "domain",
    "title",
    "maturity",
    "knowledge_cycle",
    "ai_reviewed",
    "author_confirmed",
    "created_at",
    "updated_at",
    "reviewed_at",
    "published_at",
    "investigations",
    "labs",
    "superseded_by",
    "superseded_at",
    "archived_from",
    "archived_at",
    "archive_reason"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "$ref": "#/$defs/node_id" },
    "domain": { "$ref": "#/$defs/domain_id" },
    "title": { "type": "string", "minLength": 1 },
    "maturity": {
      "enum": ["draft", "reviewed", "published", "superseded", "archived"]
    },
    "knowledge_cycle": {
      "oneOf": [
        { "enum": ["initial_learning", "revision"] },
        { "type": "null" }
      ]
    },
    "ai_reviewed": { "type": "boolean" },
    "author_confirmed": { "type": "boolean" },
    "created_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" },
    "reviewed_at": { "$ref": "#/$defs/nullable_date" },
    "published_at": { "$ref": "#/$defs/nullable_date" },
    "investigations": {
      "description": "Investigations for which this Note is the knowledge_note origin or promotion target. Context-only related_nodes do not create a backlink.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^investigations/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
      }
    },
    "labs": {
      "description": "Labs directly related to this Note. Every listed Lab must contain this Note ID in lab.related_nodes, and every Lab related_nodes entry with an existing Note must be reciprocated here.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^labs/[a-z0-9]+(?:-[a-z0-9]+)*/README\\.md$"
      }
    },
    "superseded_by": {
      "oneOf": [
        { "$ref": "#/$defs/node_id" },
        { "type": "null" }
      ]
    },
    "superseded_at": { "$ref": "#/$defs/nullable_date" },
    "archived_from": {
      "oneOf": [
        { "enum": ["draft", "reviewed", "published"] },
        { "type": "null" }
      ]
    },
    "archived_at": { "$ref": "#/$defs/nullable_date" },
    "archive_reason": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "maturity": { "const": "draft" } },
        "required": ["maturity"]
      },
      "then": {
        "properties": {
          "knowledge_cycle": {
            "enum": ["initial_learning", "revision"]
          },
          "ai_reviewed": { "const": false },
          "author_confirmed": { "const": false },
          "reviewed_at": { "type": "null" },
          "published_at": { "type": "null" },
          "superseded_by": { "type": "null" },
          "superseded_at": { "type": "null" },
          "archived_from": { "type": "null" },
          "archived_at": { "type": "null" },
          "archive_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "maturity": { "const": "reviewed" } },
        "required": ["maturity"]
      },
      "then": {
        "properties": {
          "knowledge_cycle": {
            "enum": ["initial_learning", "revision"]
          },
          "ai_reviewed": { "const": true },
          "author_confirmed": { "const": false },
          "reviewed_at": { "$ref": "#/$defs/date" },
          "published_at": { "type": "null" },
          "superseded_by": { "type": "null" },
          "superseded_at": { "type": "null" },
          "archived_from": { "type": "null" },
          "archived_at": { "type": "null" },
          "archive_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "maturity": { "const": "published" } },
        "required": ["maturity"]
      },
      "then": {
        "properties": {
          "knowledge_cycle": { "type": "null" },
          "ai_reviewed": { "const": true },
          "author_confirmed": { "const": true },
          "reviewed_at": { "$ref": "#/$defs/date" },
          "published_at": { "$ref": "#/$defs/date" },
          "superseded_by": { "type": "null" },
          "superseded_at": { "type": "null" },
          "archived_from": { "type": "null" },
          "archived_at": { "type": "null" },
          "archive_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "maturity": { "const": "superseded" } },
        "required": ["maturity"]
      },
      "then": {
        "properties": {
          "knowledge_cycle": { "type": "null" },
          "ai_reviewed": { "const": true },
          "author_confirmed": { "const": true },
          "reviewed_at": { "$ref": "#/$defs/date" },
          "published_at": { "$ref": "#/$defs/date" },
          "superseded_by": { "$ref": "#/$defs/node_id" },
          "superseded_at": { "$ref": "#/$defs/date" },
          "archived_from": { "type": "null" },
          "archived_at": { "type": "null" },
          "archive_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "maturity": { "const": "archived" } },
        "required": ["maturity"]
      },
      "then": {
        "properties": {
          "superseded_by": { "type": "null" },
          "superseded_at": { "type": "null" },
          "archived_from": {
            "enum": ["draft", "reviewed", "published"]
          },
          "archived_at": { "$ref": "#/$defs/date" },
          "archive_reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "archived_from": { "const": "draft" } },
              "required": ["archived_from"]
            },
            "then": {
              "properties": {
                "knowledge_cycle": {
                  "enum": ["initial_learning", "revision"]
                },
                "ai_reviewed": { "const": false },
                "author_confirmed": { "const": false },
                "reviewed_at": { "type": "null" },
                "published_at": { "type": "null" }
              }
            }
          },
          {
            "if": {
              "properties": { "archived_from": { "const": "reviewed" } },
              "required": ["archived_from"]
            },
            "then": {
              "properties": {
                "knowledge_cycle": {
                  "enum": ["initial_learning", "revision"]
                },
                "ai_reviewed": { "const": true },
                "author_confirmed": { "const": false },
                "reviewed_at": { "$ref": "#/$defs/date" },
                "published_at": { "type": "null" }
              }
            }
          },
          {
            "if": {
              "properties": { "archived_from": { "const": "published" } },
              "required": ["archived_from"]
            },
            "then": {
              "properties": {
                "knowledge_cycle": { "type": "null" },
                "ai_reviewed": { "const": true },
                "author_confirmed": { "const": true },
                "reviewed_at": { "$ref": "#/$defs/date" },
                "published_at": { "$ref": "#/$defs/date" }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "nullable_date": {
      "oneOf": [
        { "$ref": "#/$defs/date" },
        { "type": "null" }
      ]
    }
  }
}
